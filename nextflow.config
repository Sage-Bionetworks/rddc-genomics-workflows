// Shared configuration, loaded for every pipeline in this repo.
//
// Cirro runs pipelines/<name>/main.nf from the repo root, so this is the only
// nextflow.config Nextflow reads. Pipeline-specific parameter defaults belong at the top
// of each main.nf. Cirro adds its own config for the executor, work directory and AWS;
// don't set those here.

manifest {
    name            = 'rddc-genomics-workflows'
    description     = 'RDDC genomics processing pipelines'
    homePage        = 'https://github.com/Sage-Bionetworks/rddc-genomics-workflows'
    nextflowVersion = '!>=25.04.0'
}

// Parameters every pipeline accepts. Cirro sets both (see each .cirro/process-input.json).
params {
    input  = null   // samplesheet (CSV)
    outdir = null   // where results are published
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Small resources for CI and laptops. Pass the test input with --input.
    test {
        params.outdir = 'results'
        process {
            resourceLimits = [cpus: 2, memory: '6.GB', time: '1.h']
        }
    }
}

